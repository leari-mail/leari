# Copy to .env.local (git-ignored) and fill in to enable "Sign in with Google / Microsoft"
# in local builds. See README → "OAuth setup". CI reads the same names from repository secrets.

# Google Cloud → APIs & Services → Credentials → OAuth client ID → "Desktop app"
LEARI_GOOGLE_CLIENT_ID=
LEARI_GOOGLE_CLIENT_SECRET=

# Microsoft Entra → App registrations → "Mobile and desktop applications" platform
LEARI_MICROSOFT_CLIENT_ID=
